# Paste into Railway -> app service -> Variables -> Raw Editor.
# Replace blank credentials and placeholder admin values before deploying.
# Postgres/Redis must match the exact service names in your Railway project.
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
BOT_TOKEN=
ADMIN_ID=
ENCRYPTION_KEY=
MONO_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_TIMEOUT=60
SUPPORT_USERNAME=
# Settings -> Networking -> Generate Domain; the app reads RAILWAY_PUBLIC_DOMAIN.
# Do not copy PUBLIC_BASE_URL=https://shop.example.com from the Compose example.
PORT=8000
PAGE_SIZE=7
CODE_COOLDOWN=30
CODE_MAX_AGE=180
TIMEZONE=Europe/Kyiv
